# Copy to .env. Never commit .env or AWS/Hugging Face credentials.
AWS_PROFILE=default
AWS_REGION=ap-northeast-2
AWS_CREDENTIAL_MODE=profile
SONIC_REGION=ap-northeast-1
SONIC_MODEL=amazon.nova-2-5-sonic
# Optional local Strands Bidi sidecar; direct keeps the existing production path.
SONIC_ENGINE=direct
STRANDS_BIDI_URL=ws://127.0.0.1:8080/ws
# Optional IAM-authenticated MCP Gateway. No third-party API keys are needed.
AGENTCORE_GATEWAY_URL=
AGENTCORE_REGION=ap-northeast-1
PORT=8787
BIND_HOST=127.0.0.1
CORE_URL=http://127.0.0.1:19101
TTS_URL=http://127.0.0.1:19102
MINICPM_URL=http://127.0.0.1:19103
SPEECH_URL=http://127.0.0.1:19104
WHISPER_URL=http://127.0.0.1:19105
# A cloud deployment requires HTTPS PUBLIC_ORIGIN, ORIGIN_HOST, and a random
# ORIGIN_VERIFY_SECRET of at least 32 characters. deploy-web.py sets these.
