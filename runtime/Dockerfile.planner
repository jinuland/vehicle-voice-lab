# A same-host benchmark image: mounts the pinned, already-installed venv/cache.
# Production packaging should copy the reviewed environment into its own image.
FROM ubuntu:24.04
RUN apt-get update -qq && apt-get install -y --no-install-recommends python3 python3-dev build-essential libgomp1 libsndfile1 ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/vehicle-compact
ENV HF_HOME=/opt/vehicle-compact/models COMPACT_SERVING=1 TOKENIZERS_PARALLELISM=false
ENTRYPOINT ["/opt/vehicle-compact/core-env/bin/python","-m","uvicorn","model_server:app","--host","0.0.0.0","--port","9101"]
